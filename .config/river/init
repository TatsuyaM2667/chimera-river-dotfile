#!/bin/sh

# --- 1. D-Bus & XDG セッション設定 ---
_uid=$(id -u)
_bus_path="/run/user/${_uid}/bus"
if [ ! -S "$_bus_path" ]; then
    dbus-daemon --session --fork --nopidfile --address="unix:path=${_bus_path}"
fi
export DBUS_SESSION_BUS_ADDRESS="unix:path=${_bus_path}"
export XDG_CURRENT_DESKTOP=river
export XDG_SESSION_TYPE=wayland

# Fcitx5 (日本語入力)
export XMODIFIERS=@im=fcitx
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export SDL_IM_MODULE=fcitx

# --- 2. XDG Desktop Portal ---
killall -q xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk 2>/dev/null
dbus-update-activation-environment DBUS_SESSION_BUS_ADDRESS WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null

find_portal_bin() {
    for d in /usr/libexec /usr/lib/xdg-desktop-portal /usr/lib /usr/bin; do
        [ -x "$d/$1" ] && { echo "$d/$1"; return 0; }
    done
    command -v "$1" 2>/dev/null
}
WLR_PORTAL=$(find_portal_bin xdg-desktop-portal-wlr)
MAIN_PORTAL=$(find_portal_bin xdg-desktop-portal)
[ -n "$WLR_PORTAL" ] && "$WLR_PORTAL" &
[ -n "$MAIN_PORTAL" ] && "$MAIN_PORTAL" &

# --- 3. 重複プロセスの一括キル ---
killall -q waybar fcitx5 rivertile awww-daemon swaybg 2>/dev/null

# --- 4. デーモン類の自動起動 ---
waybar &
fcitx5 -d &

# 壁紙 (awww があれば使用、なければ swaybg)
if command -v awww-daemon >/dev/null 2>&1; then
    awww-daemon &
    FIRST_WALL=$(ls -1 "$HOME/Pictures/wallpapers" 2>/dev/null | head -n1)
    if [ -n "$FIRST_WALL" ]; then
        sleep 0.5
        awww img "$HOME/Pictures/wallpapers/$FIRST_WALL" --transition-type fade --transition-duration 1 &
    fi
else
    swaybg -c '#060913' &
fi

# タイリングレイアウト
riverctl default-layout rivertile
rivertile -view-padding 10 -outer-padding 14 &

# --- 5. 見ため・操作感の設定 ---
riverctl border-width 3
riverctl border-color-focused "0x7fdceb"    # シアン
riverctl border-color-unfocused "0x1e1e2e"  # ダークブルー

riverctl focus-follows-cursor normal
riverctl set-cursor-warp on-focus-change
riverctl hide-cursor timeout 3000
riverctl hide-cursor when-typing enabled

# スクラッチパッド
scratch_tag=$((1 << 20))
riverctl map normal Super P toggle-focused-tags ${scratch_tag}
riverctl map normal Super+Shift P set-view-tags ${scratch_tag}
all_but_scratch_tag=$(( ((1 << 32) - 1) ^ $scratch_tag ))
riverctl spawn-tagmask ${all_but_scratch_tag}

# --- 6. キーバインド設定 ---
riverctl map normal Super Return spawn foot
riverctl map normal Super D spawn fuzzel
riverctl map normal Super Q close
riverctl map normal Super+Shift E exit
riverctl map normal Super F toggle-fullscreen
riverctl map normal Super Space toggle-float
riverctl map normal Super+Shift Space toggle-float
riverctl map normal Super+Shift L spawn "swaylock -f -c 060913"

# クイック設定 / 壁紙ピッカー
riverctl map normal Super S spawn "$HOME/.local/bin/control-center.sh"
riverctl map normal Super+Shift W spawn "$HOME/.local/bin/wallpaper-picker.sh"

# フォーカス移動・入れ替え
riverctl map normal Super J focus-view next
riverctl map normal Super K focus-view previous
riverctl map normal Super+Shift J swap next
riverctl map normal Super+Shift K swap previous
riverctl map normal Super H send-layout-cmd rivertile "main-ratio -0.05"
riverctl map normal Super L send-layout-cmd rivertile "main-ratio +0.05"

# マルチモニタ
riverctl map normal Super Period focus-output next
riverctl map normal Super Comma focus-output previous
riverctl map normal Super+Shift Period send-to-output next
riverctl map normal Super+Shift Comma send-to-output previous

# ワークスペース (1-9, 0)
for i in $(seq 1 9); do
    tags=$((1 << (i - 1)))
    riverctl map normal Super $i set-focused-tags $tags
    riverctl map normal Super+Shift $i set-view-tags $tags
    riverctl map normal Super+Control $i toggle-focused-tags $tags
    riverctl map normal Super+Shift+Control $i toggle-view-tags $tags
done
riverctl map normal Super 0 set-focused-tags 0xFFFFFFFF
riverctl map normal Super+Shift 0 set-view-tags 0xFFFFFFFF

# フローティングリサイズ

# マウス操作
riverctl map-pointer normal Super BTN_LEFT move-view
riverctl map-pointer normal Super BTN_RIGHT resize-view
riverctl map-pointer normal Super BTN_MIDDLE toggle-float

# スクリーンショット
riverctl map normal None Print spawn "grim -g \"\$(slurp)\" - | wl-copy"
riverctl map normal Super Print spawn "grim - | wl-copy"

# メディアキー
riverctl map normal None XF86AudioRaiseVolume  spawn "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"
riverctl map normal None XF86AudioLowerVolume  spawn "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
riverctl map normal None XF86AudioMute          spawn "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
riverctl map normal None XF86MonBrightnessUp   spawn "brightnessctl set +5%"
riverctl map normal None XF86MonBrightnessDown spawn "brightnessctl set 5%-"
riverctl map normal Super T spawn foot
riverctl keyboard-layout jp
riverctl send-layout-cmd rivertile "main-ratio 0.5"

# --- waybar addition ---
pkill waybar 2>/dev/null
waybar &

# --- ショートカットキーの設定 ---
# PrtSc: 範囲選択して撮影 (クリップボードと ~/Pictures/Screenshots に保存)
riverctl map normal None Print spawn 'sh -c "FILE=~/Pictures/Screenshots/shot_\$(date +%Y%m%d_%H%M%S).png; grim -g \"\$(slurp)\" \$FILE && wl-copy < \$FILE"'

# Shift + PrtSc: 全画面撮影
riverctl map normal Shift Print spawn 'sh -c "FILE=~/Pictures/Screenshots/shot_\$(date +%Y%m%d_%H%M%S).png; grim \$FILE && wl-copy < \$FILE"'

# Super + B: Firefox起動
riverctl map normal Super B spawn firefox

# Super + Shift + R: 画面録画の開始 / 停止
riverctl map normal Super+Shift R spawn ~/.local/bin/toggle-record.sh

riverctl corner-radius 14 2>/dev/null
riverctl border-radius-focused 14 2>/dev/null
riverctl border-radius-unfocused 14 2>/dev/null
riverctl blur on 2>/dev/null
riverctl blur-passes 3 2>/dev/null
riverctl blur-radius 10 2>/dev/null
riverctl blur-optimized on 2>/dev/null
riverctl shadow on 2>/dev/null
riverctl shadow-radius 25 2>/dev/null
riverctl shadow-color "0x060913cc" 2>/dev/null
riverctl shadow-offset-x 0 2>/dev/null
riverctl shadow-offset-y 8 2>/dev/null
riverctl active-dim 0.05 2>/dev/null
riverctl opacity-focused 1.0 2>/dev/null
riverctl opacity-unfocused 0.85 2>/dev/null
riverctl animation on 2>/dev/null
riverctl animation-speed 300 2>/dev/null

# Super + Alt + 1~9: ウィンドウを移動して自分も一緒に追従する
for i in $(seq 1 9); do
    tags=$((1 << ($i - 1)))
done

# Super + Alt + 1~9: ウィンドウを移動して自分も追従する
for i in $(seq 1 9); do
    tags=$((1 << ($i - 1)))
done
for i in $(seq 1 9); do
    tags=$((1 << ($i - 1)))
done

for i in $(seq 1 9); do
    tags=$((1 << ($i - 1)))
done
for i in 1 2 3 4 5 6 7 8 9; do
    tags=$((1 << ($i - 1)))
done
