{
    "layer": "top", "position": "top", "height": 34,
    "margin-top": 8, "margin-left": 12, "margin-right": 12, "spacing": 4,
    "modules-left": ["river/tags", "mpris", "river/window"],
    "modules-center": ["cava", "clock"],
    "modules-right": ["group/volume", "group/backlight", "group/network", "group/bluetooth", "battery", "tray"],

    "river/tags": { "num-tags": 9 },
    "river/window": { "max-length": 40 },

    "clock": {
        "format": " {:%H:%M   %m/%d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "mpris": {
        "format": "{player_icon} {title} - {artist}",
        "format-paused": "{status_icon} <i>{title} - {artist}</i>",
        "player-icons": { "default": "▶", "mpv": "🎵", "spotify": "", "firefox": "" },
        "status-icons": { "paused": "⏸" },
        "max-length": 35
    },

    "cava": {
        "framerate": 30, "autosens": 1, "bars": 12, "method": "pulse", "source": "auto",
        "hide_on_silence": true,
        "format-icons" : [" ", "▂", "▃", "▄", "▅", "▆", "▇", "█" ]
    },

    "group/volume": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 400, "transition-left-to-right": false },
        "modules": ["pulseaudio", "pulseaudio/slider"]
    },
    "pulseaudio": {
        "format": "{icon} {volume}%", "format-muted": "󰖁 Muted",
        "format-icons": { "default": ["", "", ""] }
    },
    "pulseaudio/slider": { "min": 0, "max": 100, "orientation": "horizontal" },

    "group/backlight": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 400, "transition-left-to-right": false },
        "modules": ["backlight", "backlight/slider"]
    },
    "backlight": {
        "format": "{icon} {percent}%", "format-icons": ["󰃞", "󰃟", "󰃠"]
    },
    "backlight/slider": { "min": 0, "max": 100, "orientation": "horizontal" },

    "group/network": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 400, "transition-left-to-right": false },
        "modules": ["network", "custom/network-status", "custom/wifi-toggle", "custom/network-settings"]
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀 Wired",
        "format-disconnected": "󰤮",
        "tooltip-format": "IPアドレス: {ipaddr}"
    },
    "custom/network-status": {
        "exec": "~/.local/bin/waybar-wifi-status.sh",
        "return-type": "json",
        "interval": 5
    },
    "custom/wifi-toggle": {
        "exec": "~/.local/bin/waybar-wifi-toggle-label.sh",
        "return-type": "json",
        "interval": 3,
        "on-click": "~/.local/bin/waybar-wifi-toggle-action.sh"
    },
    "custom/network-settings": {
        "format": "󰒓",
        "tooltip-format": "詳細設定を開く",
        "on-click": "nm-connection-editor"
    },

    "group/bluetooth": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 400, "transition-left-to-right": false },
        "modules": ["bluetooth", "custom/bt-status", "custom/bt-toggle", "custom/bt-settings"]
    },
    "bluetooth": {
        "format": " {status}",
        "format-connected": " {device_alias}",
        "format-disabled": "󰂲",
        "tooltip-format": "詳細はホバーで表示"
    },
    "custom/bt-status": {
        "exec": "~/.local/bin/waybar-bt-status.sh",
        "return-type": "json",
        "interval": 5
    },
    "custom/bt-toggle": {
        "exec": "~/.local/bin/waybar-bt-toggle-label.sh",
        "return-type": "json",
        "interval": 3,
        "on-click": "~/.local/bin/waybar-bt-toggle-action.sh"
    },
    "custom/bt-settings": {
        "format": "󰒓",
        "tooltip-format": "詳細設定を開く",
        "on-click": "blueman-manager"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "tray": { "spacing": 8 }
}
